# Optional: docker compose up works without copying this file.
# Local development only; do not reuse these defaults for AWS or a shared host.
COMPOSE_PROJECT_NAME=isekai-memory-local
ISEKAI_LOCAL_BIND_HOST=127.0.0.1
ISEKAI_LOCAL_PORT=8100
# Change BEFORE the first start. Changing this later does not rotate an existing DB password.
# Single quotes keep dollar signs literal in Compose .env files.
ISEKAI_LOCAL_DB_PASSWORD='isekai-local-only'

# Optional Entra OIDC. See docs/entra-oidc.md; no client secret is required.
ISEKAI_MEMORY_ENTRA__ENABLED=false
ISEKAI_MEMORY_ENTRA__TENANT_ID=
ISEKAI_MEMORY_ENTRA__AUDIENCE=
ISEKAI_MEMORY_ENTRA__CLIENT_ID=
ISEKAI_MEMORY_ENTRA__SCOPE=Memory.Access
ISEKAI_MEMORY_ENTRA__REQUIRED_ROLE=ADE.User
ISEKAI_MEMORY_ENTRA__ALLOW_LEGACY_TOKENS=true

# Optional dedicated GitHub OAuth app; secret stays on the server. See docs/github-login.md.
ISEKAI_MEMORY_GITHUB__ENABLED=false
ISEKAI_MEMORY_GITHUB__CLIENT_ID=
ISEKAI_MEMORY_GITHUB__CLIENT_SECRET=
# JSON strings: usernames and numeric IDs can be mixed, e.g. '["ch015","123456"]'.
# Bare digits mean an ID; use @123 for a username consisting only of digits.
ISEKAI_MEMORY_GITHUB__ALLOWED_USER_IDS='[]'
ISEKAI_MEMORY_GITHUB__ALLOW_LEGACY_TOKENS=true
