# Standalone Docker image runtime settings. Docker build does not read this file.
# Optional: copy to .env.image, then use docker run --env-file .env.image.
# SQLite is also the image default. Mount a named volume at /data to reuse the DB.
ISEKAI_MEMORY_DATABASE_URL=sqlite:////data/memory.db
# For PostgreSQL, replace the URL above and set PGPASSWORD; migrate before serving.
# ISEKAI_MEMORY_DATABASE_URL=postgresql://isekai@isekai-memory-pg:5432/isekai_memory
# PGPASSWORD=isekai

# Optional workaround only for ARM Docker VMs that exit with code 132; see docs/local-docker.md.
# OPENSSL_armcap=0

# Keep project-scoped token authentication enabled. Tokens are issued separately.
ISEKAI_MEMORY_AUTH_ENABLED=true
ISEKAI_MEMORY_GENERATION_ENABLED=false

# Optional single-tenant Entra OIDC; fill identifiers before enabling.
ISEKAI_MEMORY_ENTRA__ENABLED=false
ISEKAI_MEMORY_ENTRA__TENANT_ID=
ISEKAI_MEMORY_ENTRA__AUDIENCE=
ISEKAI_MEMORY_ENTRA__CLIENT_ID=
ISEKAI_MEMORY_ENTRA__SCOPE=Memory.Access
ISEKAI_MEMORY_ENTRA__REQUIRED_ROLE=ADE.User
ISEKAI_MEMORY_ENTRA__ALLOW_LEGACY_TOKENS=true

# Optional dedicated GitHub OAuth app; fill credentials and allowlist before enabling.
ISEKAI_MEMORY_GITHUB__ENABLED=false
ISEKAI_MEMORY_GITHUB__CLIENT_ID=
ISEKAI_MEMORY_GITHUB__CLIENT_SECRET=
# JSON array of GitHub usernames and/or numeric IDs, for example ["ch015","123456"].
ISEKAI_MEMORY_GITHUB__ALLOWED_USER_IDS=[]
ISEKAI_MEMORY_GITHUB__ALLOW_LEGACY_TOKENS=true
